# Copy to .env. Keep model credentials on the server; never distribute this file.
# 复制为 .env，模型凭证仅保留在服务端，禁止分发。
PORT=8787
TRANSLATION_MODEL=claude-opus-5-5
# Configure an API key OR a supported gateway bearer token.
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
# Leave unset for the official API. For a local gateway, use its actual address.
# ANTHROPIC_BASE_URL=http://127.0.0.1:PORT
